; Copyright (c) 2009-2012, Stels

[Version]
Signature=$WINDOWS NT$
Class=USB
ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%MFGNAME%
CatalogFile=stelsusb.cat
DriverVer=01/01/2012,2.0.0.0

[Manufacturer]
%MFGNAME%=DeviceList,NTamd64

[DestinationDirs]
STELSUSB.CopyDrivers=10,system32\drivers
STELSUSB.CopyDriversV64=10,system32\drivers

[SourceDisksFiles]
stelsusb32.sys=1
stelsusb64.sys=1

[SourceDisksNames]
1=%INSTDISK%,,,

[DeviceList]
%DESCRIPTION%=DriverInstall,USB\VID_FACE&PID_0333

[DeviceList.NTamd64]
%DESCRIPTION%=DriverInstall,USB\VID_FACE&PID_0333

[DriverInstall.NT]
CopyFiles=STELSUSB.CopyDrivers
AddReg=STELSUSB.AddReg

[DriverInstall.NTamd64]
CopyFiles=STELSUSB.CopyDriversV64
AddReg=STELSUSB.AddRegv64

[STELSUSB.CopyDrivers]
stelsusb32.sys

[STELSUSB.CopyDriversV64]
stelsusb64.sys

[DriverInstall.NT.Services]
AddService=STELSUSB,2,DriverService

[DriverInstall.NTamd64.Services]
AddService=STELSUSB,2,DriverServicev64

[DriverService]
DisplayName=%DESCRIPTION%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\stelsusb32.sys

[DriverServicev64]
DisplayName=%DESCRIPTION%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\stelsusb64.sys

[DriverInstall.nt.hw]
AddReg=STELSUSB.AddReg

[STELSUSB.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,stelsusb32.sys

[STELSUSB.AddRegv64]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,stelsusb64.sys


[Strings]
MFGNAME="Стелс"
INSTDISK="Установочный диск Стелс"
DESCRIPTION="Устройство серии Мираж USB"
FRIENDLYNAME="Устройство серии Мираж USB"
